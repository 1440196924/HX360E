+// Accumulates its lifetime into *ns on scope exit (any return path).
+struct HxDiagTimeScope {
+  std::chrono::steady_clock::time_point t0;
+  uint64_t* ns;
+  explicit HxDiagTimeScope(uint64_t* n)
+      : t0(std::chrono::steady_clock::now()), ns(n) {}
+  ~HxDiagTimeScope() {
+    *ns += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                       std::chrono::steady_clock::now() - t0)
+                       .count());
+  }
+};
+
+// Prints diagnostic-only lines (frame timings, pass buckets, render area
+// shrinking) straight to hilog instead of through xenia's logger: on HarmonyOS
+// neither of the logger's sinks is usable for high-volume diagnostics - the
+// hilog sink requires log_to_logcat=true and crashes the boot thread, and the
+// file sink flushes lazily (roughly one line per 50 seconds) so the reports
+// never show up while they are still relevant. The port's own logging goes
+// through the same hilog tag, so the existing capture tooling sees these too.
+template <typename... Args>
+inline void HXDiagLog(fmt::format_string<Args...> fmt, Args&&... args) {
+  const std::string line = fmt::format(fmt, std::forward<Args>(args)...);
+  OH_LOG_Print(LOG_APP, LOG_INFO, 0x0000, "HX360E", "%{public}s", line.c_str());
+}
