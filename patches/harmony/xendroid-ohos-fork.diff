+#if XE_PLATFORM_OHOS
+// HarmonyOS: forward xenia logs to hilog (the sandbox log file isn't readable
+// via hdc, and hilog is the platform-standard sink).
+#undef LOG_DOMAIN
+#undef LOG_TAG
+#define LOG_DOMAIN 0x0000
+#define LOG_TAG "HX360E"
+
+class OhosLogSink final : public LogSink {
+ public:
+  void Write(const char* buf, size_t size) override;
+  void Flush() override;
+
+ private:
+  void WriteLineBuffer();
+
+  // ::LogLevel is hilog's global enum (xe::LogLevel would shadow it).
+  ::LogLevel current_level_ = LOG_INFO;
+  bool is_line_continuation_ = false;
+  size_t line_buffer_used_ = 0;
+  char line_buffer_[1023 + 1];
+};
+
+void OhosLogSink::Write(const char* buf, size_t size) {
+  while (size) {
+    const void* newline = std::memchr(buf, '\n', size);
+    size_t line_remaining =
+        newline ? size_t(static_cast<const char*>(newline) - buf) : size;
+    while (line_remaining) {
+      assert_true(line_buffer_used_ < xe::countof(line_buffer_));
+      size_t append_count =
+          std::min(line_remaining,
+                   xe::countof(line_buffer_) - size_t(1) - line_buffer_used_);
+      std::memcpy(line_buffer_ + line_buffer_used_, buf, append_count);
+      buf += append_count;
+      size -= append_count;
+      line_remaining -= append_count;
+      line_buffer_used_ += append_count;
+      if (line_buffer_used_ >= xe::countof(line_buffer_) - size_t(1)) {
+        WriteLineBuffer();
+        is_line_continuation_ = true;
+      }
+    }
+    if (newline) {
+      if (line_buffer_used_ || !is_line_continuation_) {
+        WriteLineBuffer();
+      }
+      is_line_continuation_ = false;
+      ++buf;
+      --size;
+    }
+  }
+}
+
+void OhosLogSink::Flush() {
+  if (line_buffer_used_) {
+    WriteLineBuffer();
+  }
+}
+
+void OhosLogSink::WriteLineBuffer() {
+  if (!is_line_continuation_ && line_buffer_used_ >= 3 &&
+      line_buffer_[1] == '>' && line_buffer_[2] == ' ') {
+    switch (line_buffer_[0]) {
+      case 'd':
+        current_level_ = LOG_DEBUG;
+        break;
+      case 'w':
+        current_level_ = LOG_WARN;
+        break;
+      case '!':
+        current_level_ = LOG_ERROR;
+        break;
+      case 'x':
+        current_level_ = LOG_FATAL;
+        break;
+      default:
+        current_level_ = LOG_INFO;
+        break;
+    }
+  }
+  if (!line_buffer_used_) {
+    line_buffer_[line_buffer_used_++] = ' ';
+  }
+  assert_true(line_buffer_used_ < xe::countof(line_buffer_));
+  line_buffer_[line_buffer_used_] = '\0';
+  OH_LOG_Print(LOG_APP, current_level_, LOG_DOMAIN, LOG_TAG, "%{public}s",
+               line_buffer_);
+  line_buffer_used_ = 0;
+}
