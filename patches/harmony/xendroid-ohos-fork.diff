+
+#include "xenia/ui/surface_ohos.h"
+
+namespace xe {
+namespace ui {
+
+bool OHOSNativeWindowSurface::GetSizeImpl(uint32_t& width_out,
+                                          uint32_t& height_out) const {
+  if (!window_) {
+    return false;
+  }
+  int32_t width = 0, height = 0;
+  if (OH_NativeWindow_NativeWindowHandleOpt(window_, GET_BUFFER_GEOMETRY, &width,
+                                            &height) != 0) {
+    return false;
+  }
+  if (width <= 0 || height <= 0) {
+    return false;
+  }
+  width_out = uint32_t(width);
+  height_out = uint32_t(height);
+  return true;
+}
+
+}  // namespace ui
+}  // namespace xe
