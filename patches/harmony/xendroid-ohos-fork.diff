+// ---------------------------------------------------------------------------
+// GPU 时间（Vulkan 时间戳查询回读，见 vulkan_command_processor）。
+// 与上面的 guest 帧间隔不同：这是 GPU 在最近一帧里实际执行命令的时间。
+// GPU 占用率 = gpu_ms / frame_ms。生产者是命令处理器线程（单个），
+// 读者是 UI 线程，跨三个原子值的撕裂读对调试读数无害。
+// ---------------------------------------------------------------------------
+namespace internal {
+inline std::atomic<float>& gpu_instant_ms() {
+  static std::atomic<float> v{0.0f};
+  return v;
+}
+inline std::atomic<float>& gpu_avg_ms() {
+  static std::atomic<float> v{0.0f};
+  return v;
+}
+}  // namespace internal
+
+// 调用一次每帧（命令处理器线程）。ms < 0 表示本次不可用（跳过）。
+inline void RecordGpuTime(float gpu_ms) {
+  if (!(gpu_ms >= 0.0f)) {
+    return;
+  }
+  internal::gpu_instant_ms().store(gpu_ms, std::memory_order_relaxed);
+  // 指数滑动平均，读起来不跳。
+  const float prev = internal::gpu_avg_ms().load(std::memory_order_relaxed);
+  const float next = prev > 0.0f ? (prev * 0.9f + gpu_ms * 0.1f) : gpu_ms;
+  internal::gpu_avg_ms().store(next, std::memory_order_relaxed);
+}
+
+// 读取 GPU 时间（任意线程）。不可用时返回 false。
+inline bool GetGpuStats(float& instant_ms, float& avg_ms) {
+  instant_ms = internal::gpu_instant_ms().load(std::memory_order_relaxed);
+  avg_ms = internal::gpu_avg_ms().load(std::memory_order_relaxed);
+  return avg_ms > 0.0f;
+}
+
 }  // namespace xe
 
 #endif  // XENIA_BASE_FRAME_STATS_H_
