@@ -0,0 +1,38 @@
+/**
+ ******************************************************************************
+ * Xenia : Xbox 360 Emulator Research Project                                 *
+ ******************************************************************************
+ * Copyright 2026.                                                            *
+ * Released under the BSD license - see LICENSE in the root for more details. *
+ ******************************************************************************
+ */
+
+#include "xenia/ui/surface_ohos.h"
+
+namespace xe {
+namespace ui {
+
+bool OHOSNativeWindowSurface::GetSizeImpl(uint32_t& width_out,
+                                          uint32_t& height_out) const {
+  if (!window_) {
+    return false;
+  }
+  int32_t width = 0, height = 0;
+  // GET_BUFFER_GEOMETRY's variable parameters are (height, width) in that
+  // order - see native_window/external_window.h. Passing them as (width,
+  // height) transposes the surface (1280x720 read back as 720x1280), which
+  // makes the presenter build a portrait swapchain and stretch the image.
+  if (OH_NativeWindow_NativeWindowHandleOpt(window_, GET_BUFFER_GEOMETRY, &height,
+                                            &width) != 0) {
+    return false;
+  }
+  if (width <= 0 || height <= 0) {
+    return false;
+  }
+  width_out = uint32_t(width);
+  height_out = uint32_t(height);
+  return true;
+}
+
+}  // namespace ui
+}  // namespace xe
