+
+#include <native_window/external_window.h>
+
+#include "xenia/ui/surface.h"
+
+namespace xe {
+namespace ui {
+
+class OHOSNativeWindowSurface : public Surface {
+ public:
+  explicit OHOSNativeWindowSurface(OHNativeWindow* window)
+      : window_(window) {}
+  TypeIndex GetType() const override { return kTypeIndex_OHOSNativeWindow; }
+  OHNativeWindow* window() const { return window_; }
+
+ protected:
+  bool GetSizeImpl(uint32_t& width_out, uint32_t& height_out) const override;
+
+ private:
+  OHNativeWindow* window_;
+};
