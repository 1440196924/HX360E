+NopAudioDriver::~NopAudioDriver() = default;
+
+bool NopAudioDriver::Initialize() { return true; }
+
+void NopAudioDriver::Shutdown() {}
+
+void NopAudioDriver::SubmitFrame(float* samples) {
+  // No output device, so the frame is complete as soon as it is received.
+  // Release the permit immediately, otherwise the guest audio thread stalls
+  // after consuming the initial queued_frames_ permits.
+  if (semaphore_) {
+    semaphore_->Release(1, nullptr);
+  }
+}
+
+void NopAudioDriver::Pause() {}
+
+void NopAudioDriver::Resume() {}
+
+void NopAudioDriver::SetVolume(float volume) {}
+
